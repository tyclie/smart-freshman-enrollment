# 复制此文件为 .env 并填入真实值；.env 不会被提交到仓库

# Flask 会话密钥（公网部署请改为随机字符串）
SECRET_KEY=freshman-demo-secret-key

# SQLite 数据库文件路径（默认使用项目根目录下的 demo.db）
# DATABASE_PATH=./demo.db

# 阿里云通义千问 VL 多模态识别（留空则使用内置模拟数据）
DASHSCOPE_API_KEY=
DASHSCOPE_OCR_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# 百度地图浏览器端 AK（留空则二维导航页无法加载底图）
BAIDU_MAP_AK=
